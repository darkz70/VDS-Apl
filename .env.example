# Скопируйте в .env для локального запуска. На bothost.ru эти значения
# задаются в панели «Переменные окружения» — файл .env там не нужен.

# Токен от @BotFather (обязательно). Не публикуйте и не коммитьте его.
BOT_TOKEN=123456789:AAexample_replace_with_your_real_token

# Кому приходят заявки. По умолчанию ровно эти два ID, менять не обязательно.
ADMIN_IDS=5992994003,1787475400

# Постоянное хранилище (на Bothost укажите /app/data, если подключён том).
# DATA_DIR=/app/data

BOT_TIMEZONE=Europe/Moscow
COMMUNITY_NAME=VoidSMP · Майнкилд

# Кулдаун на отправку заявок в секундах (3600 = 1 час, 0 = отключить)
APPLICATION_COOLDOWN_SEC=3600
